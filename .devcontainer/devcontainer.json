{
  "name": "Kubernetes Dev Environment",
  "features": {
    // Keep this, as it safely handles kubectl installation
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest"
    }
  },
  // This downloads and moves kind to your system path automatically
  "postCreateCommand": "curl -Lo ./kind https://kind.sigs.k8s.io/dl/v0.25.0/kind-linux-amd64 && chmod +x ./kind && sudo mv ./kind /usr/local/bin/kind"
}
